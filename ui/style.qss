QWidget {
    background: transparent;
    color: #d6d6d6;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow, #root { background: #0b0b0b; }

#header { background: #0b0b0b; border-bottom: 1px solid #1f1f1f; }
#footer { background: #0b0b0b; border-top: 1px solid #1f1f1f; }

#title { color: #ffffff; font-size: 14px; font-weight: 700; letter-spacing: 4px; }
#subtitle, #meta { color: #6a6a6a; font-size: 11px; }
#section { color: #6a6a6a; font-size: 10px; font-weight: 600; letter-spacing: 3px; }
#status { color: #9d9d9d; font-size: 12px; }

#video { background: #000000; border: 1px solid #1c1c1c; margin: 16px; }
#sidebar { background: #111111; border-left: 1px solid #1f1f1f; }

QPushButton {
    background: transparent;
    border: 1px solid #2b2b2b;
    color: #b8b8b8;
    padding: 9px 6px;
}
QPushButton:hover { border-color: #5a5a5a; color: #ffffff; }
QPushButton:checked { background: #f2f2f2; border-color: #f2f2f2; color: #0b0b0b; }
QPushButton:disabled { border-color: #1d1d1d; color: #3a3a3a; }

#segment { border: none; padding: 10px 4px; }
#segment:hover { color: #ffffff; }
#segment:checked { background: transparent; color: #ffffff; }

#indicator { background: #f2f2f2; }

#sliderTitle { color: #b8b8b8; font-size: 12px; }
#sliderValue { color: #ffffff; font-size: 12px; font-weight: 600; }

QSlider#slider { min-height: 22px; }
QSlider#slider::groove:horizontal {
    height: 2px;
    background: #2b2b2b;
}
QSlider#slider::sub-page:horizontal { background: #f2f2f2; }
QSlider#slider::handle:horizontal {
    background: #f2f2f2;
    width: 10px;
    height: 10px;
    margin: -4px 0;
}
QSlider#slider::handle:horizontal:hover { background: #ffffff; }
#sideScroll { background: #111111; border-left: 1px solid #1f1f1f; }
QScrollBar:vertical { background: #111111; width: 6px; margin: 0; }
QScrollBar::handle:vertical { background: #2b2b2b; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #5a5a5a; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }